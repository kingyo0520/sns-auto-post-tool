{
  "name": "sns-auto-post-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Notionをソースにした就活生向け採用アカウントのSNS自動投稿ツール(Instagram + note半自動、無料スタック)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "tsx src/generate.ts",
    "publish": "tsx src/publish.ts"
  },
  "dependencies": {
    "@notionhq/client": "^3.1.3",
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
